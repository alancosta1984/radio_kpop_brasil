platform :ios, '11.0'

flutter_application_path = File.expand_path('..', __dir__)
podhelper_path = File.join(flutter_application_path, '.ios', 'Flutter', 'podhelper.rb')

if File.exist?(podhelper_path)
  load podhelper_path
else
  puts "⚠️ Warning: podhelper.rb not found, skipping pod install configuration."
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  if File.exist?(podhelper_path)
    flutter_install_all_ios_pods(flutter_application_path)
  else
    puts "⚠️ Warning: flutter_install_all_ios_pods not executed due to missing podhelper.rb."
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
    end
  end
end

# ios/Podfile

platform :ios, '12.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_installation
  install_all_flutter_pods(File.dirname(File.realpath(__FILE__)))
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_installation

  # Adicione outros pods aqui se necessário
end
